{
  "name": "netdeck",
  "version": "0.4.31",
  "description": "NetDeck — cliente SSH / Telnet / Serial com cofre de chaves e pastas de hosts",
  "main": "src/main/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --win",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "serialport": "^12.0.0",
    "ssh2": "^1.16.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.netdeck.app",
    "productName": "NetDeck",
    "files": [
      "src/**/*",
      "package.json",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "NetDeck <dev@netdeck.local>",
      "synopsis": "Cliente SSH, Telnet e Serial com cofre de chaves",
      "artifactName": "NetDeck-${version}.${ext}",
      "executableArgs": [
        "--no-sandbox"
      ],
      "icon": "build/icon.png",
      "desktop": {
        "StartupWMClass": "NetDeck"
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "afterInstall": "build/after-install.sh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "NetDeck-${version}-mac-${arch}.${ext}"
    },
    "asarUnpack": [
      "node_modules/@lydell/**",
      "node_modules/node-pty/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "noronhasn",
        "repo": "noronhaterm"
      }
    ],
    "nsis": {
      "artifactName": "NetDeck-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "NetDeck-${version}-portable.${ext}"
    }
  },
  "author": "NetDeck <dev@netdeck.local>",
  "homepage": "https://github.com/noronhasn/netdeck",
  "optionalDependencies": {
    "@lydell/node-pty": "*"
  }
}
