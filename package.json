{
  "name": "noronhaterm",
  "version": "0.2.0",
  "description": "NoronhaTerm — cliente SSH / Telnet / Serial com cofre de chaves e pastas de hosts",
  "main": "src/main/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --win",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "serialport": "^12.0.0",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.noronha.term",
    "productName": "NoronhaTerm",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "author": "Noronha <dev@noronha.local>",
  "homepage": "https://example.com/noronhaterm"
}
