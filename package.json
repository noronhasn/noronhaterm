{
  "name": "noronhaterm",
  "version": "0.3.0",
  "description": "NoronhaTerm — cliente SSH / Telnet / Serial com cofre de chaves e pastas de hosts",
  "main": "src/main/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --win",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "serialport": "^12.0.0",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.noronha.term",
    "productName": "NoronhaTerm",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "Noronha <dev@noronha.local>",
      "synopsis": "Cliente SSH, Telnet e Serial com cofre de chaves",
      "artifactName": "NoronhaTerm-${version}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "author": "Noronha <dev@noronha.local>",
  "homepage": "https://example.com/noronhaterm"
}
